# Salin ke .env.local lalu isi dengan nilai proyek Anda, lalu jalankan:
#   flutter run --dart-define-from-file=.env.local
#
# Ambil SUPABASE_URL dan SUPABASE_PUBLISHABLE_KEY dari
# dashboard Supabase > Project Settings > Data API.
# SUPABASE_SYNC_SECRET harus sama persis dengan yang diisi di
# supabase/setup/enable_rls_policies.sql

SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SYNC_SECRET=...
