# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Kredensial build. `SUPABASE_SYNC_SECRET` ada di dalam binary aplikasi, jadi
# masuk riwayat git berarti bocor permanen dan tidak bisa dicabut. Berkas
# `.example` tetap di-commit sebagai template.
/.env
/.env.*
!/.env.*.example

# Policy RLS yang sudah diisi secret aslinya. Yang di-commit hanya templatnya,
# jadi secret tidak pernah ikut ter-*commit*.
/supabase/setup/*.sql
!/supabase/setup/*.sql.example

# Metadata lokal Supabase CLI.
/supabase/.temp/

